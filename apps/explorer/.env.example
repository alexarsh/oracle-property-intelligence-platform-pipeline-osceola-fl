# Elephant MCP endpoint (streamable HTTP). Local dev: start @elephant-xyz/mcp with PORT=8877.
ORACLE_MCP_URL=http://localhost:8877/mcp
# Optional bearer token forwarded as `Authorization: Bearer …` (matches MCP_HTTP_AUTH_TOKEN on the server).
ORACLE_MCP_AUTH_TOKEN=
# Anthropic key for the /agent page (Vercel AI SDK + @ai-sdk/anthropic). Absent => the page shows a notice.
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-4-5).
AGENT_MODEL=claude-sonnet-4-5
# Optional: absolute path to the repo's artifacts directory (auto-discovered by walking up from cwd).
OSCEOLA_ARTIFACTS_DIR=
# Optional: public URL of the hosted MCP shown on /mcp when it differs from ORACLE_MCP_URL (e.g. behind a proxy).
NEXT_PUBLIC_MCP_PUBLIC_URL=
