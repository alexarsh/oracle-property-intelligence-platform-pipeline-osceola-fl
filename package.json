{
  "name": "oracle-osceola",
  "version": "0.1.0",
  "private": true,
  "description": "Oracle Property Intelligence pipeline for Osceola County, FL — DuckDB + IPFS, MCP-ready, zero standing infrastructure cost.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b packages/shared packages/pipeline",
    "pipeline": "npm run --workspace @osceola/pipeline cli --"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.0"
  }
}
