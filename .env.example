# ---- Pipeline (packages/pipeline) -------------------------------------------
# Filebase (IPFS pinning). Free tier is enough for this dataset. Never commit real values.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=oracle-osceola
# Optional overrides
# FILEBASE_IPNS_LABEL=oracle-osceola-runs
# OSCEOLA_DATA_DIR=./data
# OSCEOLA_TAX_YEAR=2025
# OSCEOLA_VERIFY_GATEWAYS=https://ipfs.io,https://dweb.link
# LOG_LEVEL=info

# ---- Explorer UI (apps/explorer) --------------------------------------------
# Hosted Elephant MCP endpoint serving the published Osceola query tables.
ORACLE_MCP_URL=http://localhost:8787/mcp
# ORACLE_MCP_AUTH_TOKEN=
# Agent (Vercel AI SDK + Anthropic)
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-4-5
